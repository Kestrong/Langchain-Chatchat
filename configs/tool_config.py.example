# 默认搜索引擎。可选：bing, duckduckgo, metaphor
import os

from configs import SQLALCHEMY_DATABASE_URI, DATABASE_SCHEMA, LLM_MODELS

ENABLE_TOOLS = []

DEFAULT_SEARCH_ENGINE = "metaphor"

# 搜索引擎匹配结题数量
SEARCH_ENGINE_TOP_K = 3

# Bing 搜索必备变量
# 使用 Bing 搜索需要使用 Bing Subscription Key,需要在azure port中申请试用bing search
# 具体申请方式请见
# https://learn.microsoft.com/en-us/bing/search-apis/bing-web-search/create-bing-search-service-resource
# 使用python创建bing api 搜索实例详见:
# https://learn.microsoft.com/en-us/bing/search-apis/bing-web-search/quickstarts/rest/python
BING_SEARCH_URL = "https://api.bing.microsoft.com/v7.0/search"
# 注意不是bing Webmaster Tools的api key，

# 此外，如果是在服务器上，报Failed to establish a new connection: [Errno 110] Connection timed out
# 是因为服务器加了防火墙，需要联系管理员加白名单，如果公司的服务器的话，就别想了GG
BING_SUBSCRIPTION_KEY = ""

# metaphor搜索需要KEY
METAPHOR_API_KEY = ""

# 心知天气 API KEY，用于天气Agent。申请：https://www.seniverse.com/
SENIVERSE_API_KEY = ""

WOLFRAM_ALPHA_API_KEY = ""

TOOL_CONFIG = {
    "aes": {
        "key": "ffcs@flmchat2024"
    },
    "shell": {
        "allow_command": [],
        "disallow_command": ["(.*|^)rm|dd|cp|mv|shutdown|reboot|poweroff|fdisk|mkfs|chmod|chown|curl|wget .*"]
    },
    "search_knowledgebase_complex": {
        "knowledgebase": ["sample"],
    },
    "text2sql": {
        "model_name": LLM_MODELS[0],
        # 数据库是否只读，请谨慎改成False，否则可能会导致无法挽回的数据丢失
        "read_only": True,
        # 是否只返回sql不执行
        "return_sql": False,
        # 返回的数据库记录数
        "top_k": 3,
        # 返回的数据库记录中字段的最大长度
        "max_string_length": 100,
        # 随机返回几条数据帮助大模型理解表结构
        "sample_rows_in_table_info": 0,
        # 是否在提供的ddl语句里面增加索引信息帮助大模型理解
        "indexes_in_table_info": True,
        "db_infos": {
            "db_name": {
                # SQLAlchemy连接字符串，支持的数据库有：
                # crate、duckdb、googlesql、mssql、mysql、mariadb、oracle、postgresql、sqlite、clickhouse、prestodb
                # 不同的数据库请查阅SQLAlchemy用法，修改sqlalchemy_connect_str，配置对应的数据库连接，如sqlite为sqlite:///数据库文件路径，下面示例为mysql
                # 如提示缺少对应数据库的驱动，请自行通过poetry安装
                "sqlalchemy_schema": os.environ.get('TEXT2SQL_DATABASE_SCHEMA', DATABASE_SCHEMA),
                "sqlalchemy_connect_str": os.environ.get('TEXT2SQL_DATABASE_URL', SQLALCHEMY_DATABASE_URI),
                # 连接参数，如超时时间等 mysql:{"read_timeout": 10}, pg: {"options": "-c statement_timeout=10000"}
                "connect_args": {"options": "-c statement_timeout=10000"},
                "description": "",
                # 是否支持数据库视图
                "view_support": True,
                # 如果想指定特定表，请填写表名称，如["sys_user","sys_dept"]，不填写走智能判断应该使用哪些表
                "table_names": [],
                # 对表名进行额外说明，辅助大模型更好的判断应该使用哪些表，尤其是SQLDatabaseSequentialChain模式下,是根据表名做的预测，很容易误判。
                "table_comments": {
                    # 如果出现大模型选错表的情况，可尝试根据实际情况填写表名和说明
                    # "tableA":"这是一个用户表，存储了用户的基本信息",
                    # "tableB":"角色表",
                },
                # 用于mysql的关联数据库信息，跨库查询
                "ref_dbs": {}
            }
        },
        "return_direct": False,
        "return_format": "str",
        "report_prompt": "你是一位专业的数据分析助手，仔细阅读和深入思考以下输入的问题和数据。\n\n问题：{{ query }}\n\n数据：{{ records }}\n\n请你深呼吸一口气，一步一步思考，然后请严格按照以下格式和要求进行输出：### 数据摘要 \n\n请用简洁的语言对数据进行整体概览性描述。\n### 数据分析 \n\n对数据从不同的维度进行深入分析，适当运用趋势分析、对比分析等统计学方法。要求：分析结果需基于客观数据，禁止涉及人员绩效、能力、工作量、责任归属等主观评价。",
        # 是否启用向量搜索
        "use_vector_sample": False,
        "vector_score_threshold": 0.7,
        "vector_search_top_k": 1,
    },
    "http_request": {
        "apis": [
            {
                "method": "GET",
                "url": "https://api.juejin.cn/search_api/v1/search",
                "headers": {},
                "cookies": {},
                "timeout": 5,
                "name": "juejin",
                "title": "掘金开发者网站搜索",
                "request_template": None,
                "response_template": "{{ data | map(attribute='content_highlight') | join('\n\n') }}",
                "description": "你可以使用该接口对掘金开发者网站的内容进行关键词搜索",
                "return_direct": True,
                "inputSchema": {
                    "properties": {
                        "query": {
                            "title": "query",
                            "description": "搜索关键词",
                            "type": "string"
                        }
                    }
                }
            }
        ]
    },
    "mcp": {
        "server_url": "http://127.0.0.1:8000",
        "timeout": 30,
        "return_direct": False,
        "disable_tools": [],
        "enable_tools": [],
        "extra_headers": {},
    }
